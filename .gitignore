# Xcode — User State (per-developer files that change constantly and cause dialog prompts)
# These must be ignored to prevent "Keep Xcode version or use version on disk?" on branch switches.
*.xcuserstate
xcuserdata/
**/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside
*.pbxuser
*.xccheckout
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Xcode Build Artifacts
DerivedData/
build/
*.hmap
*.ipa
*.app
*.dSYM.zip
*.dSYM

# Xcode Scheme Management
# Keep shared schemes (xcshareddata) but ignore personal/local ones (xcuserdata)
*.xcodeproj/xcuserdata/**/*.xcscheme

# macOS Junk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns

# Swift Package Manager
.build/
.swiftpm/xcode/xcuserdata/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# IDE (VS Code, etc.)
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/worktrees/
.claude/plans/

# SwiftData — prevents database conflicts across branches and developers
*.sqlite
*.sqlite-wal
*.sqlite-shm

# User-generated content (app-created scan images)
Documents/scan_*.jpg

# Build archives
*.xcarchive
